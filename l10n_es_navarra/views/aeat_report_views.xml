<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_l10n_es_navarra_report_form" model="ir.ui.view">
        <field name="name">l10n.es.navarra.report.form</field>
        <field name="model">l10n.es.aeat.report</field>
        <field name="inherit_id" ref="l10n_es_aeat.view_l10n_es_aeat_report_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@type='action']" position="after">
                <field name="is_navarra_model" invisible="1"/>
                <button
                        name="%(action_wizard_navarra_export)d"
                        type="action"
                        string="Export to Hacienda Navarra"
                        attrs="{'invisible': ['|', ('state', 'not in', ('posted', 'done')), ('is_navarra_model', '=', False)]}"
                        icon="fa-share"
                />
            </xpath>
            <xpath expr="//button[@type='action']" position="attributes">
                <attribute name="attrs">{'invisible': ['|', ('state', 'not in', ('posted', 'done')), ('is_navarra_model', '=', True)]}</attribute>
            </xpath>
        </field>
    </record>

</odoo>