<odoo>

    <record id="view_l10n_es_navarra_mod715_report_tree" model="ir.ui.view">
        <field name="name">l10n.es.navarra.mod715.report.tree</field>
        <field name="model">l10n.es.navarra.mod715.report</field>
        <field name="inherit_id" ref="l10n_es_aeat.view_l10n_es_aeat_report_tree" />
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="string">715-745 reports</attribute>
            </tree>
            <field name="period_type" position="after">
                <field name="casilla_01" />
            </field>
        </field>
    </record>
    <record id="view_l10n_es_aeat_mod715_report_form" model="ir.ui.view">
        <field name="name">l10n.es.navarra.mod715.report.form</field>
        <field name="model">l10n.es.navarra.mod715.report</field>
        <field name="inherit_id" ref="l10n_es_aeat.view_l10n_es_aeat_report_form" />
        <field name="arch" type="xml">
            <field name="partner_bank_id" position="before">
                <field name="payment_method" />
            </field>
            <field name="export_config_id" position="replace"/>
            <group name="group_declaration" position="after">
                <group
                        string="Resultado"
                        name="group_result"
                        invisible="state == 'draft'"
                        col="3"
                >
                    <group
                            class="oe_subtotal_footer oe_right"
                            invisible="state == 'draft'"
                            colspan="2"
                    >
                        <field
                                name="casilla_01"
                                readonly="state != 'calculated'"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                        />
                    </group>
                </group>
                <notebook invisible="state == 'draft'">
                    <page string="Tax lines">
                        <field name="tax_line_ids" nolabel="1" readonly="1">
                            <tree editable="bottom">
                                <field name="field_number_navarra" />
                                <field name="name_navarra" />
                                <field name="amount" />
                                <button
                                        name="get_calculated_move_lines"
                                        type="object"
                                        help="Show journal items"
                                        aria-label="Show journal items"
                                        title="Show journal items"
                                        icon="fa-search-plus"
                                />
                            </tree>
                        </field>
                    </page>
                </notebook>
            </group>
            <form position="inside">
                <div class="oe_chatter">
                    <field
                            name="message_follower_ids"
                            widget="mail_followers"
                            groups="base.group_user"
                    />
                    <field name="activity_ids" widget="mail_activity" />
                    <field name="message_ids" widget="mail_thread" />
                </div>
            </form>
        </field>
    </record>

    <record id="action_l10n_es_navarra_715_report" model="ir.actions.act_window">
        <field name="name">Model 715-745</field>
        <field name="res_model">l10n.es.navarra.mod715.report</field>
        <field name="view_mode">tree,form</field>
        <field name="help">Create and query Navarra Model 715-745 reports</field>
    </record>
    <record
            model="ir.actions.act_window.view"
            id="action_l10n_es_navarra_715_report_tree"
    >
        <field name="sequence" eval="2" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_l10n_es_navarra_mod715_report_tree" />
        <field name="act_window_id" ref="action_l10n_es_navarra_715_report" />
    </record>
    <record
            model="ir.actions.act_window.view"
            id="action_l10n_es_navarra_715_report_form"
    >
        <field name="sequence" eval="3" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_l10n_es_aeat_mod715_report_form" />
        <field name="act_window_id" ref="action_l10n_es_navarra_715_report" />
    </record>
    <menuitem
            id="menu_navarra_715_report"
            parent="l10n_es_navarra.menu_navarra_report"
            action="action_l10n_es_navarra_715_report"
            sequence="715"
            name="Model 715-745"
    />

</odoo>

