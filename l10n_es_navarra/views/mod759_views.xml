<odoo>

    <record id="view_l10n_es_navarra_mod759_report_list" model="ir.ui.view">
        <field name="name">l10n.es.navarra.mod759.report.list</field>
        <field name="model">l10n.es.navarra.mod759.report</field>
        <field name="inherit_id" ref="l10n_es_aeat.view_l10n_es_aeat_report_tree" />
        <field name="arch" type="xml">
            <list position="attributes">
                <attribute name="string">759-760 reports</attribute>
            </list>
            <field name="period_type" position="after">
                <field name="casilla_01" />
            </field>
        </field>
    </record>
    <record id="view_l10n_es_aeat_mod759_report_form" model="ir.ui.view">
        <field name="name">l10n.es.navarra.mod759.report.form</field>
        <field name="model">l10n.es.navarra.mod759.report</field>
        <field name="inherit_id" ref="l10n_es_aeat.view_l10n_es_aeat_report_form" />
        <field name="arch" type="xml">
            <field name="partner_bank_id" position="before">
                <field name="payment_method" />
            </field>
            <field name="export_config_id" position="replace"/>
            <group name="group_declaration" position="after">
                <group
                        string="Resultado"
                        name="group_result"
                        invisible="state == 'draft'"
                        col="3"
                >
                    <group
                            class="oe_subtotal_footer oe_right"
                            invisible="state == 'draft'"
                            colspan="2"
                    >
                        <field
                                name="casilla_01"
                                readonly="state != 'calculated'"
                                widget="monetary"
                                options="{'currency_field': 'currency_id'}"
                        />
                    </group>
                </group>
                <notebook invisible="state == 'draft'">
                    <page string="Tax lines">
                        <field name="tax_line_ids" nolabel="1" readonly="1">
                            <list editable="bottom">
                                <field name="field_number_navarra" />
                                <field name="name_navarra" />
                                <field name="amount" />
                                <button
                                        name="get_calculated_move_lines"
                                        type="object"
                                        help="Show journal items"
                                        aria-label="Show journal items"
                                        title="Show journal items"
                                        icon="fa-search-plus"
                                />
                            </list>
                        </field>
                    </page>
                </notebook>
            </group>
            <form position="inside">
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_l10n_es_navarra_759_report" model="ir.actions.act_window">
        <field name="name">Model 759-760</field>
        <field name="res_model">l10n.es.navarra.mod759.report</field>
        <field name="view_mode">list,form</field>
        <field name="help">Create and query Navarra Model 759-760 reports</field>
    </record>
    <record
            model="ir.actions.act_window.view"
            id="action_l10n_es_navarra_759_report_list"
    >
        <field name="sequence" eval="2" />
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_l10n_es_navarra_mod759_report_list" />
        <field name="act_window_id" ref="action_l10n_es_navarra_759_report" />
    </record>
    <record
            model="ir.actions.act_window.view"
            id="action_l10n_es_navarra_759_report_form"
    >
        <field name="sequence" eval="3" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_l10n_es_aeat_mod759_report_form" />
        <field name="act_window_id" ref="action_l10n_es_navarra_759_report" />
    </record>
    <menuitem
            id="menu_navarra_759_report"
            parent="l10n_es_navarra.menu_navarra_report"
            action="action_l10n_es_navarra_759_report"
            sequence="759"
            name="Model 759-760"
    />

</odoo>

