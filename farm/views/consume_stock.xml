<?xml version="1.0" encoding="UTF-8"?>
<openerp>
<data>
    <record model="ir.ui.view" id="view_consume_stock_tree">
            <field name="name">consume.stock.tree</field>
            <field name="model">farm.consume.stock</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Event">
                        <field name="state"/>
                        <field name="to_location"/>
                        <field name="date"/>
                </tree>
            </field>
        </record>
        <record model="ir.ui.view" id="view_consume_stock_form">
            <field name="name">consume.stock.form</field>
            <field name="model">farm.consume.stock</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Consume stock">
                <header>
                    <field name="state" widget="statusbar"/>
                    <button name="confirm" invisible="state != 'draft'"
                        string="Confirm Consume" id="consume_confirm"
                        type="object" />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="type" readonly="state == 'confirmed'"/>
                            <field name="origin" readonly="state == 'confirmed'"/>
                            <field name="product_id" readonly="state == 'confirmed'" domain="[('id', '=', allowed_products)]"/>
                        </group>
                        <group>
                            <field name="date" readonly="state == 'confirmed'"/>
                            <field name="to_location" readonly="state == 'confirmed'" domain="[('id', '=',allowed_locations)]"/>
                            <field name="lot_id" readonly="state == 'confirmed'" domain="[('id', '=',allowed_lots)]"/>
                        </group>
                    </group>
                    <group invisible="1">
                        <field name="allowed_products"/>
                        <field name="allowed_lots"/>
                        <field name="allowed_locations"/>
                    </group>
                </sheet>
                </form>
            </field>
        </record>
        <record model="ir.ui.view" id="farm_consume_stock_search_view">
            <field name="name">farm.consume.stock.search</field>
            <field name="model">farm.consume.stock</field>
            <field name="arch" type="xml">
                <search string="Search consume stock">
                    <group>
                        <field name="product_id" />
                    </group>
                    <newline />
                    <group expand="0" string="Group by...">
                        <filter string="Origin"
                                name="origin"
                                domain="[]"
                                context="{'group_by': 'origin'}" />
                        <filter string="Destinity"
                                name="to_location"
                                domain="[]"
                                context="{'group_by': 'to_location'}" />
                        <filter string="State"
                                name="state"
                                domain="[]"
                                context="{'group_by': 'state'}" />
                    </group>
                </search>
            </field>
        </record>
</data>
</openerp>