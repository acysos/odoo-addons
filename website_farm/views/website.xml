<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="portal_hr_breadcrumbs" name="Portal HR Breadcrumbs" inherit_id="portal.portal_breadcrumbs">
        <xpath expr="//a[@href='/my/home']" position="attributes">
            <attribute name="href">/farm</attribute>
        </xpath>
    </template>
    <template id="portal_layout_hide" name="Portal Layout hidden" inherit_id="portal.portal_layout">
        <xpath expr="//div[@t-if='not no_breadcrumbs and not my_details and not breadcrumbs_searchbar']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <!-- <xpath expr="//div[@id='wrap']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath> -->
    </template>


    <template id="website_farm_menuitem">
          <html t-att="html_data or {}">
          <div class="col-4 text-center farm_menuitem" style="margin-top:10px;">
               <body t-att-class="body_classname">
                <t t-raw="0"/>
            </body>
          </div>
          </html>
    </template>
    <template id="animal_search" name="Animal Search">
        <div class="animal_search">
        <div class="form-row mt8">
            <label class="col-4 control-label form_label" for="name">CROTAL</label>
            <textarea class="form-control col-6 farm_label" id="name" rows="4" name="name" />
        </div>
        <div class="form-row mt8">
            <div class="row">
                <div class="col-6">
                    <span>Tipo:</span>&#32;<span  id="type" style="color:blue"/>
                </div>
                <div class="col-6">
                    <span>Explotacion:</span>&#32;<span  id="farm" style="color:blue"/>
                </div>
            </div>
            <div class="row">
                <div class="col-6">
                    <span>Fecha nacimiento:</span>&#32;<span  id="arrival_date" style="color:blue"/>
                </div>
                <div class="col-6">
                    <span>Origen:</span>&#32;<span  id="origin" style="color:blue"/>
                </div>>
            </div>
            <div class="row">
                <div class="col-6">
                    <span>Ultimo parto:</span>&#32;<span  id="last_farrowing" style="color:blue"/>
                </div>
                <div class="col-6">
                    <span>Madre:</span>&#32;<span id="mother" style="color:blue"/>
                </div>
            </div>
            <div>
                <span class="error-label" style="color:red;"/>
            </div>
        </div>
        </div>
    </template>
    <template id="website_farm_menu" name="Portal Granja">
        <t t-call="website.layout">
        <h1 class="text-center">Farm Operations</h1>
        <div id="menu" class="row">
            
               <t t-call="website_farm.website_farm_menuitem">
               
                <a href="/farm/animal" class="d-block h-100" itemprop="url">
                    <img src="/website_farm/static/src/img/fichar.svg" style="max-height: 70px;"/>
                    <p>Listados</p>
                 </a>
               </t>
            <t t-call="website_farm.website_farm_menuitem">

                <a href="/farm/farrowing" class="d-block h-100" itemprop="url">
                    <img src="/website_farm/static/src/img/cordero.jpeg" style="max-height: 70px;"/>
                    <p>Partos</p>
                </a>
            </t>
            <t t-call="website_farm.website_farm_menuitem">

                <a href="/farm/removal" class="d-block h-100" itemprop="url">
                    <img src="/website_farm/static/src/img/papelera.jpeg" style="max-height: 70px;"/>
                    <p>Bajas</p>
                </a>
            </t>
            <!--
            <t t-call="website_farm.website_farm_menuitem">

                <a href="/farm/weaning" class="d-block h-100" itemprop="url">
                    <img src="/website_farm/static/src/img/destete.png" style="max-height: 70px;"/>
                    <p>Destete</p>
                </a>
            </t>
            <t t-call="website_farm.website_farm_menuitem">
                    <a href="/farm/regroup" class="d-block h-100" itemprop="url">
                        <img src="/website_farm/static/src/img/reagrupar.png" style="max-height: 70px;"/>
                        <p>Reagrupar</p>
                    </a>
            </t>
            -->
        </div>
        </t>
    </template>
    <template id="website_animal" name="Animal">
        <t t-call="website.layout">
            <div class="row">
                <div class="col-">
                    <h1>
                        <a href="/farm">
                            <span>Atrás</span>
                        </a>
                    </h1>
                </div>
                <div class="col-9 text-right" style="overflow:visible;">
                        <h1><img src="/website_farm/static/src/img/fichar.svg"
                                 style="max-height: 40px;">Listados</img></h1>
                </div>
            </div>
            <t t-call="website_farm.animal_search"/>
            <div class="row text-center" style="margin-top:10px;margin.bottom:10px;">
                <t t-foreach="farms" t-as="farm">
                    <div class="col-6">
                        <h2><span t-field="farm['farm'].name"/></h2>
                        <div><span>Madres:</span><span t-esc="farm['animals']"/></div>
                        <div><span>Corderos:</span><span t-esc="farm['group_count']"/></div>
                    </div>
                </t>

            </div>
        </t>
    </template>

    <template id="website_removal" name="farm removal">
        <t t-call="website.layout">
            <div class="row">
                <div class="col-3">
                    <h1>
                        <a href="/farm">
                            <span>Atrás</span>
                        </a>
                    </h1>
                </div>
                <div class="col-9 text-right" style="overflow:visible;">
                    <h1><img src="/website_farm/static/src/img/papelera.jpeg"
                             style="max-height:40px;">Bajas</img></h1>
                </div>
            </div>
            <div class="text-center">
                <form method="post" enctype="multipart/form-data"
                      class="removal_req_form">
                    <div class="modal-body modal_form">
                        <input type="hidden" name="csrf_token"
                               t-att-value="request.csrf_token()" />
                        <input type="hidden" name="employee_id" id="employee_id"
                               t-att-value="employee_id" />

                        <t t-call="website_farm.animal_search"/>
                        <div class="form-row mt8 reason">
                            <label class="col-4 control-label form_label" for="reason_id">Motivo:</label>
                            <select class="form-control col-6" id="reason_id"
                                    name="reason_id">
                                <option value="" selected="True">
                                    <span>---</span>
                                </option>
                                <t t-foreach="reasons" t-as="t">
                                    <option t-att-value="t.id">
                                        <t t-esc="t.name" />
                                    </option>
                                </t>
                            </select>
                        </div>
                        <div class="form-row mt8" style="display:none;">
                            <span id="selecionado"></span>
                        </div>
                        <br />
                        <div class="form-row mt8 error-div">
                            <span class="error-label" style="color:red;"/>
                        </div>
                        <button type="button" class="btn-primary removal_req_btn">Confirmar</button>
                    </div>
                </form>
            </div>
        </t>
    </template>
    <template id="website_farrowing" name="My holidays">
    <t t-call="website.layout">
        <div class="row">

            <div class="col-3">
                <h1>
                    <a href="/farm">
                        <span>Atrás</span>
                    </a>
                </h1>
            </div>
            <div class="col-9 text-right" style="overflow:visible;">
                <h1><img src="/website_farm/static/src/img/cordero.jpeg"
                         style="max-height: 40px;" >Partos</img></h1>

            </div>
        </div>
    <div class="text-center farrowing_menu" style="margin-top:10px;margin.bottom:10px;">
            <h2><!--
                <a href="/farm/farrowing/request" class="d-block h-100" itemprop="url">

                    <p><span class="button">Nuevos Partos</span></p>
                </a>-->
                <button type="button" class="btn-primary farrowing_req_btn">Nuevo Parto</button>
            </h2>
        </div>


        <div class="farrow_body">
            <table style="margin-left:5px;width:100%">
                <thead>
                    <th style="padding: 8px;">Orden</th>
                    <th style="padding: 8px;">Fecha</th>
                    <th style="padding: 8px;">Explotación</th>
                    <th style="padding: 8px;">Especie</th>
                    <th style="padding: 8px;">Total</th>
                    <th style="padding: 8px;">Estado</th>
                </thead>
                <tbody>
                    <t t-foreach="lines" t-as="farrowing">
                        <tr>
                            <td style="border-bottom: 0.5px solid grey;padding: 8px;">
                                <span t-esc="farrowing['farrow'].name" />
                            </td>
                            <td style="border-bottom: 0.5px solid grey;padding: 8px;">
                                <span t-field="farrowing['farrow'].timestamp" widget="date"/>
                            </td>

                            <td style="border-bottom: 0.5px solid grey;padding: 8px;">
                                <span t-field="farrowing['farrow'].farm"/>
                            </td>
                            <td style="border-bottom: 0.5px solid grey;padding: 8px;">
                                <span t-field="farrowing['farrow'].specie"/>
                            </td>
                            <td style="border-bottom: 0.5px solid grey;padding: 8px;">
                                <span t-esc="farrowing['quantity']"/>
                            </td>
                            <td style="border-bottom: 0.5px solid grey;padding: 8px;">
                                <span t-field="farrowing['farrow'].state"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </div>

    </t>
    </template>
    <template id="farrowing_request">
        <div class="modal fade" id="farrowing_request_modal" role="dialog">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title">Nueva Petición</h4>
                    </div>
                    <t t-if="message">
                        <div class="modal-body modal_form">
                            <t t-raw="message" />
                        </div>
                        <div class="modal-footer">
                            <button type="button" id="btn_reload"
                                    class="timeoff_req btn btn-default" data-dismiss="modal">OK</button>
                        </div>
                    </t>
                    <t t-else="">
                        <form method="post" enctype="multipart/form-data"
                              class="farrowing_req_form">
                            <div class="modal-body modal_form farrowing_modal">
                                <input type="hidden" name="csrf_token"
                                       t-att-value="request.csrf_token()" />
                                <input type="hidden" name="employee_id" id="employee_id"
                                       t-att-value="employee_id" />
                                <input type="hidden" name="order_id" id="order_id"
                                   t-att-value="order" />
                                <div class="form-row mt8 description">
                                    <label class="col-4 control-label form_label" for="name">CROTAL MADRE
                                    </label>
                                    <textarea class="form-control col-6 farm_label" id="name"
                                              rows="4" name="name" />
                                </div>
                                <div class="form-row mt8 date">
                                    <div class="row">
                                        <div class="col-6">
                                            <span>Explotacion:</span><span id="farm" style="color:blue"/>
                                        </div>
                                        <div class="col-6">
                                            <span>Fecha nacimiento:</span><span id="arrival_date" style="color:blue"/>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-6">

                                            <span>Origen:</span><span id="origin" style="color:blue"/>
                                        </div>
                                        <div class="col-6">

                                            <span>Ultimo parto:</span><span id="last_farrowing" style="color:blue"/>
                                        </div>
                                    </div>


                                </div>
                                <div class="form-row mt8 crias">
                                    <label class="col-4 control-label form_label" for="date">Nº Crias</label>
                                    <input class="form-control col-6" id="live" type="numeric"
                                           name="live"/>
                                </div>
                                <div class="form-row mt8">
                                    <h2>Nuevos crotales</h2>
                                    <div class="div_label1">
                                    <label class="form_label" for="label1">CROTAL CORDERO</label>
                                    <input class="col-5" id="label1" type="text"
                                           name="label1"/>
                                        <label class="form_label" for="male1">MACHO</label>
                                        <input id="male1" value="male" type="radio"
                                               name="sex1"/>
                                        <label class="form_label" for="female1">HEMBRA</label>
                                        <input  id="female1" value='female' type="radio"
                                               name="sex1" checked="True"/>
                                    </div>
                                    <div class="div_label2">
                                    <label class="form_label" for="label2">CROTAL CORDERO</label>
                                    <input class="col-5" id="label2" type="text"
                                           name="label2"/>
                                        <label class="form_label" for="male2">MACHO</label>
                                        <input id="male2" value="male" type="radio"
                                               name="sex2"/>
                                        <label class="form_label" for="female2">HEMBRA</label>
                                        <input  id="female2" value="female" type="radio"
                                               name="sex2" checked="True"/>
                                    </div>
                                    <div class="div_label3">
                                    <label class="form_label" for="label3">CROTAL CORDERO</label>
                                    <input class="col-5" id="label3" type="text"
                                           name="label3"/>
                                        <label class="form_label" for="male3">MACHO</label>
                                        <input id="male3" value="male" type="radio"
                                               name="sex3"/>
                                        <label class="form_label" for="female3">HEMBRA</label>
                                        <input  id="female3" value="female" type="radio"
                                               name="sex3" checked="True"/>
                                    </div>
                                    <div class="div_label4">
                                    <label class="form_label" for="label4">CROTAL CORDERO</label>
                                    <input class="col-5" id="label4" type="text"
                                           name="label4"/>
                                        <label class="form_label" for="male4">MACHO</label>
                                        <input id="male4" value="male" type="radio"
                                               name="sex4"/>
                                        <label class="form_label" for="female4">HEMBRA</label>
                                        <input  id="female4" value="female" type="radio"
                                               name="sex4" checked="True"/>
                                    </div>
                                    <div class="div_label5">
                                    <label class="form_label" for="label5">CROTAL CORDERO</label>
                                    <input class="col-5" id="label5" type="text"
                                           name="label5"/>
                                        <label class="form_label" for="male5">MACHO</label>
                                        <input id="male5" value="male" type="radio"
                                               name="sex5"/>
                                        <label class="form_label" for="female5">HEMBRA</label>
                                        <input  id="female5" value="female" type="radio"
                                               name="sex5" checked="True"/>
                                    </div>

                                </div>
                            </div>
                            <div class="form-row mt8 error-div">
                                <span class="error-label" style="color:red;"/>
                            </div>
                            <div class="form-row mt8 next_farrowing">
                                <span class="btn btn-primary" id="next_farrowing">Siguiente</span>
                            </div>
                            <div class="row">
                                <div class="col-6 text-center">
                                    <span id="farrowing_req_submit"
                                          class="btn btn-primary mb-2">Finalizar</span>
                                </div>
                                <div class="col-6 text-center">
                                    <button type="cancel" class="btn btn-primary"
                                            data-dismiss="modal">Cancelar</button>
                                </div>
                            </div>


                            <div class="form-row mt8 tabla">
                                <table style="margin-left:5px;width:100%" id="farrow-table">
                                    <thead>
                                        <th style="padding: 8px;">Crotal</th>
                                        <th style="padding: 8px;">Crias</th>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="farrowings" t-as="farrow">
                                            <tr>
                                                <td style="border-bottom: 0.5px solid grey;padding: 8px;">
                                                    <span t-esc="farrow['tag']" />
                                                </td>
                                                <td style="border-bottom: 0.5px solid grey;padding: 8px;">
                                                    <span t-esc="farrow['live']" />
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>

                        </form>
                    </t>
                </div>
            </div>
        </div>
    </template>
</odoo>